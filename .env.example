# scitrace 配置模板：复制为 .env 后填写
# 环境变量前缀 SCITRACE_，嵌套字段用双下划线（见 docs/SPEC.md §5.1）

# ---- LLM（三角色可分别配置，实现成本分级路由）----
# 主模型：负责答案合成（要强）
SCITRACE_LLM__MODEL=deepseek/deepseek-chat
# 摘要模型：负责证据筛选与摘要（可便宜）
SCITRACE_LLM__SUMMARY_MODEL=deepseek/deepseek-chat
# Agent 模型：负责工具选择（需稳定的工具调用能力）
SCITRACE_LLM__AGENT_MODEL=deepseek/deepseek-chat
SCITRACE_LLM__API_KEY=
# OpenAI 兼容端点示例：https://api.deepseek.com
SCITRACE_LLM__API_BASE=

# ---- Embedding（默认本地模型，中文场景推荐）----
SCITRACE_EMBEDDING__BACKEND=local
SCITRACE_EMBEDDING__MODEL=BAAI/bge-small-zh-v1.5

# ---- 元数据源（可选，填了能提高限流额度）----
SCITRACE_METADATA__CROSSREF_MAILTO=
SCITRACE_METADATA__SEMANTIC_SCHOLAR_API_KEY=
SCITRACE_METADATA__OPENALEX_MAILTO=

# ---- 检索策略：dense | dense_mmr | hybrid_rrf | hybrid_rrf_rerank ----
SCITRACE_RETRIEVAL__STRATEGY=dense_mmr
SCITRACE_RETRIEVAL__K=10

# ---- 证据筛选：llm | cross_encoder ----
SCITRACE_SCREENING__BACKEND=llm
SCITRACE_SCREENING__MIN_RELEVANCE=5

# ---- 成本闸门 ----
SCITRACE_AGENT__MAX_COST_USD=1.0
SCITRACE_AGENT__TIMEOUT_SECONDS=500
